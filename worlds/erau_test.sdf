<?xml version="1.0" ?>
    <sdf version="1.9">
    <world name="erau_test">
        <light name="sunUTC" type="directional">
            <pose>0 0 500 0 -0 0</pose>
            <cast_shadows>true</cast_shadows>
            <intensity>1</intensity>
            <direction>0.001 0.625 -0.78</direction>
            <diffuse>0.904 0.904 0.904 1</diffuse>
            <specular>0.271 0.271 0.271 1</specular>
            <attenuation>
                <range>2000</range>
                <linear>0</linear>
                <constant>1</constant>
                <quadratic>0</quadratic>
            </attenuation>
            <spot>
                <inner_angle>0</inner_angle>
                <outer_angle>0</outer_angle>
                <falloff>0</falloff>
            </spot>
        </light>
        
        <include>
            <uri>model://erau_test</uri>
            <pose>0.0 472.808 -5.0 0 0 0</pose>
        </include>

        <model name="takeofff_pltaform">
            <static>true</static>
            <pose>0 0 -0.4 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>2.0 2.0 0.8</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>2.0 2.0 0.8</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.1 0.8 0.1 1</ambient>
                        <diffuse>0.1 0.8 0.1 1</diffuse>
                    </material>
                </visual>
                <!--
                  Feature-rich top surface for the downward stereo cameras.
                  The box top is at z=0.4 in this model, so the 1 mm offset
                  prevents z-fighting without changing the collision surface.
                -->
                <visual name="vio_tracking_texture">
                    <pose>0 0 0.401 0 0 0</pose>
                    <cast_shadows>false</cast_shadows>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>2.0 2.0</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>1 1 1 1</ambient>
                        <diffuse>1 1 1 1</diffuse>
                        <specular>0.05 0.05 0.05 1</specular>
                        <pbr>
                            <metal>
                                <albedo_map>model://erau_test/materials/odom_text.jpeg</albedo_map>
                            </metal>
                        </pbr>
                    </material>
                </visual>
            </link>
        </model>


            
        <scene>
            <!-- sky color “background” behind clouds -->
            <background>0.3 0.3 0.3 1.0</background>
            <!-- ambient light in the scene -->
            <ambient>0.95 0.95 0.95 1</ambient>
            <!-- enable shadows -->
            <shadows>true</shadows>
            <sky>
                <clouds>
                <speed>2</speed>
                </clouds>
            </sky>
        </scene>

        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <world_frame_orientation>ENU</world_frame_orientation>
            <latitude_deg>40.787982</latitude_deg>
            <longitude_deg>-74.027</longitude_deg>
            <elevation>7.9248</elevation>
        </spherical_coordinates>
        
        <wind>
            <linear_velocity>0 2 0</linear_velocity>
        </wind>
        
        <physics type="ode">
            <max_step_size>0.004</max_step_size>
            <real_time_factor>1.0</real_time_factor>
            <real_time_update_rate>250</real_time_update_rate>
        </physics>
        <gravity>0 0 -9.8</gravity>
        <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
        <atmosphere type="adiabatic"/>
    </world>
    </sdf>
