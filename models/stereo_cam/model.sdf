<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
    <model name='stereo_cam'>
        <pose>0 0 0 0 0 0</pose>
        <self_collide>false</self_collide>
        <static>false</static>


        <!-- ***** CONSTANTS ***** -->
        <!-- Space between the two camera centers: 0.2 meters -->
        <frame name="LEFT_CAM_FRAME" attached_to="camera_link">
            <pose>-0.1 0.10 -0.07 0 1.57 0</pose>
        </frame>
        <frame name="RIGHT_CAM_FRAME" attached_to="camera_link">
            <pose>-0.1 -0.10 -0.07 0 1.57 0</pose>
        </frame>



        <link name="camera_link">
            <inertial>
                <pose>0.03 0.03 0.03 0 0 0</pose>
                <mass>0.050</mass>
                <inertia>
                    <ixx>0.00004</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.00004</iyy>
                    <iyz>0</iyz>
                    <izz>0.00004</izz>
                </inertia>
            </inertial>



            <!-- ***** LEFT CAMERA ***** -->
            <visual name="stereo_cam/visual/housing_left">
                <pose relative_to="LEFT_CAM_FRAME">0 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.02 0.03 0.03</size>
                    </box>
                </geometry>
            </visual>
            <visual name="stereo_cam/visual/lens_left">
                <pose relative_to="LEFT_CAM_FRAME">0.015 0 0 0 1.5707 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.008</radius>
                        <length>0.01</length>
                    </cylinder>
                </geometry>
            </visual>
            <visual name="stereo_cam/visual/lens_glass_left">
                <pose relative_to="LEFT_CAM_FRAME">0.014 0 0 0 0 0</pose>
                <geometry>
                    <sphere>
                        <radius>0.0079</radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient>.4 .4 .5 .95</ambient>
                    <diffuse>.4 .4 .5 .95</diffuse>
                    <specular>1 1 1 1</specular>
                    <emissive>0 0 0 1</emissive>
                </material>
            </visual>

            <!-- ***** RIGHT CAMERA ***** -->
            <visual name="stereo_cam/visual/housing_right">
                <pose relative_to="RIGHT_CAM_FRAME">0 0 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.02 0.03 0.03</size>
                    </box>
                </geometry>
            </visual>
            <visual name="stereo_cam/visual/lens_right">
                <pose relative_to="RIGHT_CAM_FRAME">0.015 0 0 0 1.5707 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.008</radius>
                        <length>0.01</length>
                    </cylinder>
                </geometry>
            </visual>
            <visual name="stereo_cam/visual/lens_glass_right">
                <pose relative_to="RIGHT_CAM_FRAME">0.014 0 0 0 0 0</pose>
                <geometry>
                    <sphere>
                        <radius>0.0079</radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient>.4 .4 .5 .95</ambient>
                    <diffuse>.4 .4 .5 .95</diffuse>
                    <specular>1 1 1 1</specular>
                    <emissive>0 0 0 1</emissive>
                </material>
            </visual>



            <!-- ***** SENSORS ***** -->
            <sensor name="imager_left" type="camera">
                <gz_frame_id>camera_left</gz_frame_id>
                <pose relative_to="LEFT_CAM_FRAME">0 0 0 0 0 0</pose>
                <camera>
                    <horizontal_fov>1.74</horizontal_fov>
                    <image>
                        <width>1280</width>
                        <height>720</height>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>3000</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
            </sensor>

            <sensor name="imager_right" type="camera">
                <gz_frame_id>camera_right</gz_frame_id>
                <pose relative_to="RIGHT_CAM_FRAME">0 0 0 0 0 0</pose>
                <camera>
                    <horizontal_fov>1.74</horizontal_fov>
                    <image>
                        <width>1280</width>
                        <height>720</height>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>3000</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
            </sensor>

            <gravity>true</gravity>
            <velocity_decay/>
        </link>
    </model>
</sdf>
